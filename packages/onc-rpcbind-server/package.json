{
	"name": "@luolapeikko/onc-rpcbind-server",
	"version": "0.0.2",
	"description": "Server implementation for ONC RPC rpcbind services.",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		},
		"default": "./dist/index.mjs"
	},
	"scripts": {
		"build": "tsdown",
		"validate": "tsc --noEmit"
	},
	"bin": {
		"onc-rpcbind-server": "index.mjs"
	},
	"files": [
		"dist",
		"index.mjs"
	],
	"keywords": [
		"xdr",
		"onc",
		"rpc",
		"rpcbind",
		"portmapper"
	],
	"author": "mharj",
	"license": "MIT",
	"repository": "github:luolapeikko/xdr-ts",
	"devDependencies": {
		"@avanio/logger-like": "^0.2.12",
		"@luolapeikko/onc-node": "workspace:*",
		"@luolapeikko/onc-rpcbind-client": "workspace:*",
		"@luolapeikko/onc-rpcbind-common": "workspace:*",
		"@luolapeikko/onc-xdr": "workspace:*",
		"@open-draft/deferred-promise": "^3.0.0",
		"@types/node": "^25.5.0",
		"@types/ws": "^8.18.1",
		"minimist": "^1.2.8",
		"net-address": "^0.0.1",
		"net-socket-address": "^0.0.1",
		"unix-socket-address": "^0.0.1",
		"ws": "^8.20.0"
	},
	"peerDependencies": {
		"@avanio/logger-like": ">= 0.0.1",
		"@luolapeikko/onc-node": "^0.0.1",
		"@luolapeikko/onc-rpcbind-common": "^0.0.2",
		"@luolapeikko/onc-xdr": "^0.0.1",
		"@open-draft/deferred-promise": ">= 3.0.0",
		"minimist": ">= 1.2.0",
		"net-address": "^0.0.1",
		"net-socket-address": "^0.0.1",
		"unix-socket-address": "^0.0.1",
		"ws": ">= 8.0.0"
	},
	"peerDependenciesMeta": {
		"ws": {
			"optional": true
		}
	}
}

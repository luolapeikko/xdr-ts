{
	"name": "@luolapeikko/onc-node",
	"version": "0.0.1",
	"description": "Service Registration, NodeJs transport implementations, and XDR buffer utilities for ONC RPC protocol.",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		},
		"default": "./dist/index.mjs"
	},
	"scripts": {
		"build": "tsdown src/index.ts --sourcemap --format cjs,esm --dts --clean -c tsconfig.build.json",
		"validate": "tsc --noEmit"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"xdr",
		"onc",
		"rpc",
		"rpcbind",
		"portmapper"
	],
	"author": "mharj",
	"license": "MIT",
	"repository": "github:luolapeikko/xdr-ts",
	"devDependencies": {
		"@luolapeikko/onc-xdr": "workspace:*",
		"@luolapeikko/onc-rpcbind-common": "workspace:*",
		"@open-draft/deferred-promise": "^3.0.0",
		"@types/node": "^25.5.0",
		"net-address": "^0.0.1",
		"net-socket-address": "^0.0.1",
		"unix-socket-address": "^0.0.1"
	},
	"peerDependencies": {
		"@luolapeikko/onc-xdr": "^0.0.1",
		"@luolapeikko/onc-rpcbind-common": "^0.0.1",
		"@open-draft/deferred-promise": ">= 3.0.0",
		"@types/node": ">= 24.0.0",
		"net-address": "^0.0.1",
		"net-socket-address": "^0.0.1",
		"unix-socket-address": "^0.0.1"
	}
}
